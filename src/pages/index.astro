---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import Testimonials from '../components/Testimonials.astro';
import QuoteForm from '../components/QuoteForm.astro';
import content from '../data/content.json';

const { businessName, services, homepageServiceIds, whyChooseUs, faq, ctaBanner, intro, foundedYear } = content;
const homeServices = services.filter(s => (homepageServiceIds ?? services.map(s => s.id)).includes(s.id));
---

<MainLayout
  title={content.seo.home.title}
  description={content.seo.home.description}
  ogImage={content.seo.home.ogImage}
>

  <!-- 1. HERO -->
  <Hero />

  <!-- 2. SERVICES: 6 cards, white bg, WP style -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-12">
        <p class="uppercase text-xs tracking-widest font-semibold mb-3 text-gray-400">WHAT WE DO</p>
        <h2 class="text-4xl font-bold text-gray-900">Our Services</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {homeServices.map((svc) => (
          <a href={`/services#${svc.id}`} class="group bg-white overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col" style="border:1px solid #e5e7eb;">
            <div class="overflow-hidden" style="height:220px;">
              <img
                src={svc.image.url}
                alt={svc.image.alt}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                onerror="this.style.background='#e5e7eb';"
              />
            </div>
            <div class="p-6 flex flex-col flex-1 items-center text-center">
              <h3 class="text-xl font-bold text-gray-900 mb-3">{svc.name}</h3>
              <p class="text-gray-500 text-sm leading-relaxed flex-1 mb-5">{svc.shortDescription}</p>
              <span class="inline-block font-bold text-sm px-6 py-2.5" style="background:#F2A93B; color:#000;">Read More</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. INTRO + WHY CHOOSE US -->
  <section class="py-20" style="background:#f9f9f9;">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-14">
        <p class="uppercase text-xs tracking-widest text-gray-400 font-semibold mb-3">WHY RELIABLEFIX</p>
        <h2 class="text-4xl font-bold text-gray-900 mb-6">Built on Trust Since {foundedYear}</h2>
        <p class="text-base text-gray-500 max-w-2xl mx-auto">{intro.text}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {whyChooseUs.map((item) => (
          <div class="bg-white p-7 text-center" style="border:1px solid #e5e7eb;">
            <div class="w-12 h-12 mx-auto mb-5 flex items-center justify-center" style="background:#F2A93B;">
              {item.icon === 'shield' && <svg class="w-5 h-5" fill="none" stroke="black" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>}
              {item.icon === 'clock' && <svg class="w-5 h-5" fill="none" stroke="black" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>}
              {item.icon === 'dollar' && <svg class="w-5 h-5" fill="none" stroke="black" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>}
              {item.icon === 'star' && <svg class="w-5 h-5" fill="none" stroke="black" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>}
            </div>
            <h3 class="font-bold text-gray-900 mb-2">{item.title}</h3>
            <p class="text-sm text-gray-500 leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. TESTIMONIALS -->
  <Testimonials />

  <!-- 5. FAQ -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-14">
        <p class="uppercase text-xs tracking-widest text-gray-400 font-semibold mb-3">COMMON QUESTIONS</p>
        <h2 class="text-4xl font-bold text-gray-900">Frequently Asked Questions</h2>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-12">
        {faq.map((item) => (
          <details class="group border-t border-gray-200">
            <summary class="flex items-center justify-between cursor-pointer list-none gap-4 py-5">
              <span class="font-semibold text-gray-900 text-base pr-4">{item.question}</span>
              <div class="w-7 h-7 flex items-center justify-center flex-shrink-0 border border-gray-200 group-open:border-yellow-400 transition-colors">
                <svg class="w-3.5 h-3.5 text-gray-500 group-open:rotate-45 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
              </div>
            </summary>
            <p class="pb-5 text-gray-500 text-base leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. CTA BANNER -->
  <section class="py-16" style="background:#0f0f0f;">
    <div class="max-w-4xl mx-auto px-6 lg:px-10 text-center">
      <h2 class="text-4xl font-bold text-white mb-4">{ctaBanner.headline}</h2>
      <p class="text-gray-400 text-base mb-8">{ctaBanner.subheadline}</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={ctaBanner.ctaPrimary.href} style="background:#F2A93B;" class="inline-block text-black font-bold text-sm px-8 py-4 hover:brightness-95 transition-all">
          {ctaBanner.ctaPrimary.label}
        </a>
        <a href={ctaBanner.ctaSecondary.href} class="inline-block text-white font-bold text-sm px-8 py-4 border-2 border-white hover:bg-white hover:text-black transition-all">
          {ctaBanner.ctaSecondary.label}
        </a>
      </div>
    </div>
  </section>

  <!-- 7. QUOTE FORM -->
  <QuoteForm />

</MainLayout>
