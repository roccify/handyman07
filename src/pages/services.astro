---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceDetail from '../components/ServiceDetail.astro';
import CTA from '../components/CTA.astro';
import content from '../data/content.json';

const seo = content.seo.services;
const hero = content.heroes.services;
---

<MainLayout title={seo.title} description={seo.description} ogImage={seo.ogImage}>
  <Hero
    headline={hero.headline}
    subheadline={hero.subheadline}
    image={hero.image}
  />

  <section class="py-14 md:py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-light">
        We offer a full range of licensed handyman services for residential properties across Rochester and Monroe County. Click any service below to learn more about how we can help.
      </p>
    </div>
  </section>

  {content.services.map((service, index) => (
    <ServiceDetail service={service} index={index} />
  ))}

  <CTA />
</MainLayout>
