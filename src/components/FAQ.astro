---
import content from '../data/content.json';
const faqs = content.faq;
---

<section class="py-12 md:py-16 bg-white border-t border-gray-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-8 h-0.5" style="background:#F2A93B;"></div>
        <span class="text-xs font-bold uppercase tracking-widest" style="color:#F2A93B;">FAQ</span>
      </div>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-gray-900">
        Common Questions
      </h2>
    </div>

    <div class="divide-y divide-gray-200 border-t border-gray-200">
      {faqs.map((faq) => (
        <details class="group py-5">
          <summary class="flex items-center justify-between cursor-pointer list-none gap-4">
            <h3 class="font-semibold text-gray-900 text-lg leading-snug pr-4">{faq.question}</h3>
            <div class="w-6 h-6 flex items-center justify-center flex-shrink-0 bg-amber-50 group-open:bg-amber-500 transition-colors">
              <svg class="w-3.5 h-3.5 text-amber-600 group-open:text-white group-open:rotate-45 transition-all" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            </div>
          </summary>
          <p class="mt-4 text-gray-500 text-base leading-relaxed max-w-2xl">{faq.answer}</p>
        </details>
      ))}
    </div>

  </div>
</section>
