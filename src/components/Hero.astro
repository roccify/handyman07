---
interface Props {
  headline?: string;
  subheadline?: string;
  image?: { url: string; alt: string; fallback: string };
  ctaPrimary?: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  tall?: boolean;
}

import content from '../data/content.json';

const {
  headline    = content.heroes.home.headline,
  subheadline = content.heroes.home.subheadline,
  image       = content.heroes.home.image,
  ctaPrimary  = content.heroes.home.ctaPrimary,
  ctaSecondary = content.heroes.home.ctaSecondary,
  tall = false
} = Astro.props;
---

{tall ? (
  <!-- HOME: full-height split hero -->
  <section class="relative bg-white overflow-hidden" style="min-height: 90vh; padding-top: 4rem;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full">
      <div class="flex flex-col lg:flex-row items-stretch" style="min-height: calc(90vh - 4rem);">

        <div class="flex-1 flex flex-col justify-center py-14 lg:py-20 lg:pr-14 xl:pr-20 order-2 lg:order-1">
          <p class="text-xs font-bold uppercase tracking-widest mb-4" style="color:#F2A93B;">{content.tagline}</p>
          <h1 class="font-display font-bold text-gray-900 leading-tight mb-5" style="font-size: clamp(2.4rem, 5vw, 3.75rem);">
            {headline}
          </h1>
          <p class="text-gray-600 leading-relaxed mb-10 max-w-lg" style="font-size: 1.2rem;">
            {subheadline}
          </p>
          {(ctaPrimary || ctaSecondary) && (
            <div class="flex flex-col sm:flex-row gap-3 mb-10">
              {ctaPrimary && (
                <a href={ctaPrimary.href} class="inline-flex items-center justify-center px-8 py-4 font-bold text-lg tracking-wide text-gray-900 hover:opacity-90 transition-opacity" style="background:#F2A93B;">
                  {ctaPrimary.label}
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
                </a>
              )}
              {ctaSecondary && (
                <a href={ctaSecondary.href} class="inline-flex items-center justify-center gap-2 px-8 py-4 font-bold text-lg border-2 text-gray-700 hover:text-white hover:bg-gray-900 transition-all" style="border-color:#F2A93B; color:#c47d10;">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
                  {ctaSecondary.label}
                </a>
              )}
            </div>
          )}
        </div>

        <div class="lg:w-[48%] order-1 lg:order-2 relative" style="min-height: 340px;">
          <div class="absolute inset-0" style={`background: ${image.fallback};`}></div>
          <img
            src={image.url}
            alt={image.alt}
            class="absolute inset-0 w-full h-full object-cover object-center"
            loading="eager"
            onerror="this.style.display='none'"
          />
          <div class="absolute bottom-0 left-0 right-0 h-1 z-10" style="background:#F2A93B;"></div>
        </div>

      </div>
    </div>
  </section>
) : (
  <!-- INNER PAGES: compact dark banner -->
  <section class="relative overflow-hidden" style="padding-top: 4rem; min-height: 260px; background: #0f0f0f;">
    <div class="absolute inset-0" style={`background: ${image.fallback};`}></div>
    <img
      src={image.url}
      alt={image.alt}
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      onerror="this.style.display='none'"
    />
    <div class="absolute inset-0" style="background:#0f0f0f; opacity:0.80;"></div>
    <div class="absolute left-0 top-0 bottom-0 w-1" style="background:#F2A93B;"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-6 h-0.5" style="background:#F2A93B;"></div>
          <span class="text-xs font-bold uppercase tracking-widest text-gray-300">{content.businessName}</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold text-white leading-tight">
          {headline}
        </h1>
        <p class="text-gray-300 mt-5 max-w-xl leading-relaxed" style="font-size: 1.15rem;">
          {subheadline}
        </p>
      </div>
    </div>
  </section>
)}
